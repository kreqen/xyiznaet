PACK_SIGNING_SECRET=replace-with-at-least-32-random-bytes

# Enable only after every live dependency below is configured.
PAYMENTS_MODE=preview
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://your-solana-rpc.example
TREASURY_WALLET=your-solana-treasury-public-key

UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Optional Metaplex Core receipt minting.
MINT_MODE=disabled
MINT_AUTHORITY_SECRET=[64,byte,json,array]
PUBLIC_APP_URL=https://pokegen.vercel.app
